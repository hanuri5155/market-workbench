# Storage
MARKET_WORKBENCH_ROOT=/opt/market-workbench
CONFIG_PATH=config/config.demo.json
ZONE_LEVELS_PATH=storage/zone_levels.json
EXECUTION_DATA_STORE_PATH=storage/execution_data_store.json
BBANDS_DIR=storage/bbands
SIMULATED_CANDLES_PATH=config/simulated_candles.demo.json
DEMO_MODE=1
STRATEGY_PROVIDER=demo_zone
ENABLE_LIVE_ORDER_PLACEMENT=0

# Indicators
BBANDS_LENGTH=20
BBANDS_MULT=2

# Exchange - Bybit endpoints
BYBIT_BASE_URL=https://api.bybit.com
RECV_WINDOW=5000
BYBIT_WS_URL=wss://stream.bybit.com/v5/public/linear
POSITION_WS_URL=wss://stream.bybit.com/v5/private?max_active_time=10m
EXECUTION_WS_URL=wss://stream.bybit.com/v5/private

# Exchange - Bybit credentials
BYBIT_API_KEY=
BYBIT_SECRET_KEY=

# Trading Symbol
SYMBOL=BTCUSDT

# Database
DB_HOST=mysql
DB_PORT=3306
DB_NAME=market_workbench
DB_USER=market_workbench
DB_PASSWORD=

# API / Web
CORS_ORIGINS=https://example.com

# Internal HTTP notify URLs
CANDLE_REST_NOTIFY_URL=http://example-api:8000/internal/candle-rest-confirmed
ZONE_DELTA_NOTIFY_URL=http://example-api:8000/internal/zones/delta
ZONE_STATE_SYNC_NOTIFY_URL=http://example-api:8000/internal/zones/state-sync
POSITION_OVERLAY_NOTIFY_URL=http://example-api:8000/internal/position-overlay-event

# Internal WebSocket URLs
STRATEGY_FLAGS_WS_URL=ws://example-api:8000/ws/control
ZONE_STATE_WS_URL=ws://example-api:8000/ws/zones

# Security / 2FA
GOOGLE_OTP_SECRET=

# Telegram
ZONE_BOT_TOKEN=
ZONE_CHAT_ID=
POSITIONS_BOT_TOKEN=
POSITIONS_CHAT_ID=

# Bot runtime
BOT_HEARTBEAT_PATH=/tmp/bot_heartbeat
BOT_HEARTBEAT_SEC=5

# Event loop watchdog (bot/api stall detection)
EVENT_LOOP_WATCHDOG_ENABLED=1
EVENT_LOOP_WATCHDOG_INTERVAL_SEC=1.0
EVENT_LOOP_WATCHDOG_LAG_THRESHOLD_SEC=2.0
EVENT_LOOP_WATCHDOG_LOG_COOLDOWN_SEC=20.0
EVENT_LOOP_WATCHDOG_MAX_TASKS=8
EVENT_LOOP_WATCHDOG_STACK_LIMIT=6

# Chart ingest diagnostics. 이름은 shadow에서 출발했지만, NATS publish와
# active gateway 전환 검증에 같이 쓰는 chart ingest 경로다.
CHART_INGEST_SHADOW_ENABLED=false
CHART_INGEST_SHADOW_INTERVALS=15,30,60,240,1440
CHART_INGEST_SHADOW_SUMMARY_INTERVAL_SEC=60
CHART_INGEST_SHADOW_LAG_WARN_MS=2000

# Broker publish shadow diagnostics (disabled by default)
# Durable broker target is NATS JetStream. Redis is retained only as a rollback profile.
CHART_BROKER_PUBLISH_SHADOW_ENABLED=false
CHART_BROKER_KIND=nats_jetstream
CHART_BROKER_PUBLISH_QUEUE_MAX=2000
CHART_BROKER_PUBLISH_CRITICAL_QUEUE_MAX=500
CHART_BROKER_PUBLISH_TIMEOUT_SEC=1.0
CHART_BROKER_PUBLISH_PARTIAL_RETRY=1
CHART_BROKER_PUBLISH_FINAL_RETRY=3
CHART_BROKER_PUBLISH_SUMMARY_INTERVAL_SEC=60

# API gateway NATS JetStream shadow subscribe (compare/log/metric only)
NATS_SHADOW_SUBSCRIBE_ENABLED=false
NATS_URL=nats://nats:4222
NATS_SUBJECT_PREFIX=candles
NATS_STREAM_PARTIAL=CHART_PARTIAL
NATS_STREAM_CRITICAL=CHART_CRITICAL
NATS_STREAM_PARTIAL_MAX_AGE_SEC=21600
NATS_STREAM_CRITICAL_MAX_AGE_SEC=604800
NATS_DUPLICATE_WINDOW_SEC=120
NATS_CONSUMER_API_GATEWAY_PARTIAL=chart-api-gateway-shadow-partial
NATS_CONSUMER_API_GATEWAY_CRITICAL=chart-api-gateway-shadow-critical
NATS_SHADOW_FETCH_BATCH=50
NATS_SHADOW_FETCH_TIMEOUT_SEC=1.0
NATS_SHADOW_ACK_WAIT_SEC=30
NATS_SHADOW_MAX_DELIVER=5
NATS_SHADOW_MAX_ACK_PENDING=1000

# API gateway NATS JetStream active fanout
# Active source는 chart_ingest_active만 사용한다. 과거 bot_http fallback은
# 운영 rollback 대상이 아니라 retired path로 취급한다.
NATS_CONSUMER_API_GATEWAY_ACTIVE_PARTIAL=chart-api-gateway-active-partial
NATS_CONSUMER_API_GATEWAY_ACTIVE_CRITICAL=chart-api-gateway-active-critical
NATS_ACTIVE_RESET_CONSUMERS_ON_START=true
NATS_ACTIVE_FETCH_BATCH=50
NATS_ACTIVE_FETCH_TIMEOUT_SEC=1.0
NATS_ACTIVE_ACK_WAIT_SEC=30
NATS_ACTIVE_MAX_DELIVER=5
NATS_ACTIVE_MAX_ACK_PENDING=1000
NATS_ACTIVE_SUMMARY_INTERVAL_SEC=60

# NATS JetStream final/reconcile durable storage worker
# - API process 안의 embedded durable worker는 기본 비활성화한다.
# - compose profile `nats-durable`의 chart-storage 서비스가 MySQL write를 담당한다.
# - 이 파일 기본값은 local/dev에서 durable worker가 실수로 뜨지 않게 disabled로 둔다.
CHART_STORAGE_ENABLED=false
NATS_FINAL_DURABLE_ENABLED=false
NATS_FINAL_DURABLE_API_EMBEDDED_ENABLED=false
NATS_FINAL_DURABLE_AUTO_CREATE_SCHEMA=false
CHART_STORAGE_CONSUMER_NAME=chart-storage-final-reconcile
NATS_CONSUMER_STORAGE_CRITICAL=chart-storage-final-reconcile
# Single-filter mode. 비워두면 기본 critical wildcard가 적용된다.
# CHART_STORAGE_FILTER_SUBJECT=candles.critical.bybit.BTCUSDT.15
CHART_STORAGE_FILTER_SUBJECT=
# Exact multi-filter mode. 지정하면 single filter보다 우선한다.
# 예: 15/30/60/240분 확정봉만 별도 durable consumer로 저장
# CHART_STORAGE_CONSUMER_NAME=chart-storage-final-reconcile-btcusdt-4tf
# NATS_CONSUMER_STORAGE_CRITICAL=chart-storage-final-reconcile-btcusdt-4tf
# CHART_STORAGE_FILTER_SUBJECTS=candles.critical.bybit.BTCUSDT.15,candles.critical.bybit.BTCUSDT.30,candles.critical.bybit.BTCUSDT.60,candles.critical.bybit.BTCUSDT.240
CHART_STORAGE_FILTER_SUBJECTS=
NATS_FINAL_DURABLE_FILTER_SUBJECT=candles.critical.*.*.*
NATS_FINAL_DURABLE_DELIVER_POLICY=new
NATS_FINAL_DURABLE_FETCH_BATCH=10
NATS_FINAL_DURABLE_FETCH_TIMEOUT_SEC=1.0
NATS_FINAL_DURABLE_ACK_WAIT_SEC=30
NATS_FINAL_DURABLE_MAX_DELIVER=20
NATS_FINAL_DURABLE_MAX_ACK_PENDING=100
NATS_FINAL_DURABLE_NAK_DELAY_SEC=2.0
NATS_FINAL_DURABLE_TERM_INVALID=true
NATS_FINAL_DURABLE_DB_SOURCE_FINAL=chart_nats_final
NATS_FINAL_DURABLE_DB_SOURCE_RECONCILE=chart_nats_reconcile
CHART_EVENT_ACTIVE_SOURCE=chart_ingest_active

# Redis legacy rollback only. Keep persistence off if this profile is ever enabled.
# CHART_BROKER_KIND=redis_streams
# CHART_BROKER_URL=redis://redis:6379/0
# CHART_BROKER_STREAM_PREFIX=candles.bybit
# CHART_BROKER_STREAM_MAXLEN=10000

# Images
API_IMAGE=
BOT_IMAGE=
# Optional. Defaults to API_IMAGE so chart-storage can run the same image,
# but can be pinned separately when the worker needs a different rollout.
CHART_STORAGE_IMAGE=
